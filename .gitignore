# CollabMD runtime state. Lives on disk and survives restarts, but most of it is
# regenerable churn that shouldn't be in history.
vault/.collabmd/yjs/           # binary CRDT state, rewritten constantly
vault/.collabmd/*.sqlite       # agent-access / hosted metadata
vault/.collabmd/structurizr/
vault/.collabmd/pull-backups/
# NOTE: vault/.collabmd/comments/ is deliberately NOT ignored -- comment threads
# are things people wrote, so they belong in backups alongside the notes.

# Obsidian per-machine UI state
vault/.obsidian/workspace.json
vault/.obsidian/workspace-mobile.json

# Secrets
.env
