# Copy this file to ".env" and fill in real values, or just run
# .\first-time-setup.ps1 which generates them for you.
#
# .env is deliberately NOT in git -- it holds the shared secrets.

# The password you give your players.
COLLABMD_PASSWORD=change-me

# Signing key for login sessions. Must be a long random string.
# Rotating it logs everyone out. Keep it stable so players stay signed in.
COLLABMD_SESSION_SECRET=change-me-to-64-random-hex-characters
